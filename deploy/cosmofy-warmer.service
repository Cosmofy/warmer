# PREPARATION ONLY. Port 29404 is an UNVERIFIED PLACEHOLDER, not an allocation.
# One active replica and one worker; no timer or scheduler is installed here.
[Unit]
Description=Cosmofy Warmer microservice
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/cosmofy/warmer-bootstrapped

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/services/warmer/current
EnvironmentFile=/home/ubuntu/services/warmer/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=DEPLOYMENT_ENVIRONMENT=production
ExecStart=/home/ubuntu/services/warmer/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 29404 --workers 1 --proxy-headers --forwarded-allow-ips=127.0.0.1 --no-access-log --timeout-graceful-shutdown 60
Restart=on-failure
RestartSec=5
TimeoutStopSec=90
KillSignal=SIGTERM
StateDirectory=cosmofy-warmer
StateDirectoryMode=0700
ReadWritePaths=/var/lib/cosmofy-warmer
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
UMask=0077
MemoryMax=1G
TasksMax=256

[Install]
WantedBy=multi-user.target
