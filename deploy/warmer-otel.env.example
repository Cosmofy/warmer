# OPTIONAL, PREPARATION ONLY. Collector identity must match the app instance.
# Keep the real /etc/cosmofy/warmer-otel.env private and root-owned (0600).
OTEL_NODE_NAME=warmer-unverified-instance
# CloudWatch/X-Ray region follows siblings; OCI host/region remains undecided.
AWS_REGION=eu-west-2
AWS_EC2_METADATA_DISABLED=true
# No AWS credential values here or in the app environment. Infrastructure owns
# the collector-only credential chain and least-privilege IAM permissions.
# Optional shared Loki overlay, private endpoint NOT YET SELECTED:
# LOKI_OTLP_ENDPOINT=https://<approved-private-loki>/otlp
