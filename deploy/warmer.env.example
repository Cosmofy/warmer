# PREPARATION ONLY: not a production .env; blanks intentionally fail closed.
# Provision private values on the selected host only after authorization.
# Token must contain at least 32 ASCII characters and no whitespace.
WARMER_API_TOKEN=
STELLATE_URL=
WARMER_STATE_DB=/var/lib/cosmofy-warmer/state.db

# Optional telemetry is OFF by default. Journald still receives stdout/stderr.
OTEL_SDK_DISABLED=true
OTEL_TRACES_EXPORTER=none
OTEL_LOGS_EXPORTER=none
OTEL_METRICS_EXPORTER=none
OTEL_SERVICE_NAME=warmer
# OTEL_NODE_NAME=warmer-<approved-instance>
# To enable tracing AFTER collector verification: OTEL_SDK_DISABLED=false,
# OTEL_TRACES_EXPORTER=otlp, and both HTTP/protobuf settings below.
# Port 25318 is an UNVERIFIED PLACEHOLDER, not a verified endpoint.
# OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://127.0.0.1:25318/v1/traces
